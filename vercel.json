{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/data.js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/scheduler/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/scheduler",
      "destination": "/index.html"
    }
  ]
}
